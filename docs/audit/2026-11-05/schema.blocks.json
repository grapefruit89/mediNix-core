{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "file:///home/moritz/repos/mediNix-core/todo/schema.json",
  "title": "mediNix Chat-Block-Extrakt",
  "description": "Schema für Block-Extrakte aus dem Chat. Alle file-Pfade MÜSSEN absolut sein.",
  "type": "object",
  "required": [
    "block_id",
    "title",
    "topics",
    "message_ids",
    "summary",
    "decisions",
    "open_questions",
    "corrections",
    "rejected",
    "next_steps"
  ],
  "properties": {
    "block_id": {
      "type": "string",
      "pattern": "^[0-9]{2}-[a-z0-9-]+$"
    },
    "title": {
      "type": "string"
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "message_ids": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 1
    },
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "status",
          "rationale",
          "verdict"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^D-[0-9]{2}-[0-9]{2}$"
          },
          "statement": {
            "type": "string"
          },
          "status": {
            "enum": [
              "decided",
              "proposed",
              "rejected",
              "open"
            ]
          },
          "rationale": {
            "type": "string"
          },
          "verdict": {
            "enum": [
              "better",
              "worse",
              "neutral",
              "unknown"
            ]
          },
          "trade_offs": {
            "type": "object",
            "properties": {
              "pro": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "con": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "code_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "file",
                "status"
              ],
              "properties": {
                "file": {
                  "type": "string",
                  "pattern": "^/home/moritz/repos/mediNix-core/.*"
                },
                "status": {
                  "enum": [
                    "exists",
                    "missing"
                  ]
                },
                "current_state": {
                  "type": "string"
                },
                "proposed_change": {
                  "type": "string"
                }
              }
            }
          },
          "source_message_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "why_open": {
            "type": "string"
          },
          "blocking": {
            "type": "boolean"
          }
        }
      }
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "source_message_ids"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "source_message_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      }
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "idea",
          "reason"
        ],
        "properties": {
          "idea": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "source_message_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      }
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "action",
          "priority"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "secret_mentions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "what": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "value_redacted": {
            "type": "boolean",
            "const": true
          }
        }
      }
    }
  }
}
