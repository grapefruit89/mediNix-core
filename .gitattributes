* text=auto eol=lf
*.nix text eol=lf
*.sh text eol=lf
*.md text eol=lf

# Generated digests (suppress diffs and keep repository language stats accurate)
exports/** linguist-generated=true
exports/** -diff
*.txt linguist-generated=true
*.txt -diff
_index.md linguist-generated=true
_index.md -diff
_root.md linguist-generated=true
_root.md -diff
_full.md linguist-generated=true
_full.md -diff
5*.md linguist-generated=true
5*.md -diff
lib.md linguist-generated=true
lib.md -diff
docs.md linguist-generated=true
docs.md -diff

# Ausnahme (2026-10-16): versionierte Listen/Allowlists in scripts/ sind TEXT und muessen
# im Review diffbar sein. Die Sammelregel `*.txt -diff` galt fuer generierte Digests,
# versteckte aber genau die Allowlists, deren Aenderungen geprueft werden muessen.
scripts/*.txt text eol=lf diff -linguist-generated
